# LangSmith credentials.
# The same key authenticates the LLM gateway (used as the OpenAI api_key /
# bearer token) AND sends traces to LangSmith.
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT="grocery-agents"
LANGSMITH_TRACING="true"

# If your LangSmith API key is linked to multiple workspaces, set this:
# LANGSMITH_WORKSPACE_ID=...
